<Window x:Class="TopMonitor.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TopMonitor 设置"
        Width="760"
        Height="560"
        MinWidth="680"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="90"
                    Margin="0,0,8,0"
                    Command="{Binding RestoreDefaultsCommand}"
                    Content="恢复默认" />
            <Button Width="90"
                    Command="{Binding SaveCommand}"
                    Content="立即保存" />
        </StackPanel>

        <TabControl>
            <TabItem Header="指标管理">
                <DataGrid Margin="8"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          ItemsSource="{Binding Widgets}">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Width="60"
                                                Binding="{Binding Enabled}"
                                                Header="显示" />
                        <DataGridTextColumn Width="*"
                                            Binding="{Binding MetricName}"
                                            Header="指标" />
                        <DataGridTextColumn Width="90"
                                            Binding="{Binding Status}"
                                            Header="状态" />
                        <DataGridTextColumn Width="70"
                                            Binding="{Binding CurrentValue}"
                                            Header="当前值" />
                        <DataGridTemplateColumn Width="120" Header="排序">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Margin="2"
                                                Command="{Binding DataContext.MoveUpCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Content="上移" />
                                        <Button Margin="2"
                                                Command="{Binding DataContext.MoveDownCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Content="下移" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="外观">
                <StackPanel Margin="20">
                    <TextBlock Text="字体大小" />
                    <Slider Margin="0,4,0,14"
                            Minimum="10"
                            Maximum="36"
                            TickFrequency="1"
                            Value="{Binding FontSize}" />
                    <TextBlock Text="背景透明度" />
                    <Slider Margin="0,4,0,14"
                            Minimum="0.2"
                            Maximum="1"
                            TickFrequency="0.05"
                            Value="{Binding Opacity}" />
                    <TextBlock Text="水平间距" />
                    <Slider Margin="0,4,0,14"
                            Minimum="0"
                            Maximum="40"
                            Value="{Binding HorizontalSpacing}" />
                    <TextBlock Text="圆角大小" />
                    <Slider Margin="0,4,0,14"
                            Minimum="0"
                            Maximum="30"
                            Value="{Binding CornerRadius}" />
                    <TextBlock Text="文字颜色（例如 #FFFFFFFF）" />
                    <TextBox Margin="0,4,0,10" Text="{Binding TextColor, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Margin="0,6"
                              Content="显示指标名称"
                              IsChecked="{Binding ShowMetricName}" />
                    <CheckBox Margin="0,6"
                              Content="显示单位"
                              IsChecked="{Binding ShowUnit}" />
                </StackPanel>
            </TabItem>

            <TabItem Header="行为">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                    <TextBlock Text="刷新模式" />
                    <ComboBox Width="180"
                              Margin="0,4,0,14"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding RefreshModes}"
                              SelectedItem="{Binding RefreshMode}" />
                    <CheckBox Margin="0,6" Content="始终置顶" IsChecked="{Binding AlwaysOnTop}" />
                    <CheckBox Margin="0,6" Content="鼠标穿透" IsChecked="{Binding ClickThrough}" />
                    <CheckBox Margin="0,6" Content="锁定位置" IsChecked="{Binding Locked}" />
                    <CheckBox Margin="0,6" Content="开机启动" IsChecked="{Binding AutoStart}" />
                    <CheckBox Margin="0,6" Content="启动时最小化到托盘" IsChecked="{Binding MinimizeOnStartup}" />
                    <TextBlock Margin="0,12,0,0" Text="关闭窗口时" />
                    <ComboBox Width="180"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding CloseBehaviors}"
                              SelectedItem="{Binding CloseBehavior}" />
                    <Separator Margin="0,18,0,12" />
                    <TextBlock FontWeight="SemiBold"
                               Text="CPU 温度访问" />
                    <TextBlock Margin="0,6,0,10"
                               Text="{Binding HardwareAccessMessage}"
                               TextWrapping="Wrap" />
                    <Button Width="180"
                            HorizontalAlignment="Left"
                            Command="{Binding InitializeHardwareAccessCommand}"
                            Content="初始化 CPU 温度访问" />
                    <Separator Margin="0,18,0,12" />
                    <TextBlock FontWeight="SemiBold"
                               Text="FPS 权限" />
                    <TextBlock Margin="0,6,0,10"
                               Text="{Binding FpsPermissionMessage}"
                               TextWrapping="Wrap" />
                    <Button Width="180"
                            HorizontalAlignment="Left"
                            Command="{Binding ConfigureFpsPermissionCommand}"
                            Content="配置 FPS 权限" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="显示器">
                <StackPanel Margin="20">
                    <TextBlock Text="目标显示器" />
                    <ComboBox Width="280"
                              Margin="0,4,0,14"
                              DisplayMemberPath="Name"
                              ItemsSource="{Binding Displays}"
                              SelectedValue="{Binding SelectedDisplayId}"
                              SelectedValuePath="Id" />
                    <TextBlock Text="位置" />
                    <ComboBox Width="180"
                              Margin="0,4"
                              ItemsSource="{Binding Anchors}"
                              SelectedItem="{Binding Anchor}" />
                    <TextBlock Margin="0,14,0,0" Text="自定义水平偏移" />
                    <TextBox Width="120" HorizontalAlignment="Left" Text="{Binding OffsetX}" />
                    <TextBlock Margin="0,10,0,0" Text="顶部偏移" />
                    <TextBox Width="120" HorizontalAlignment="Left" Text="{Binding OffsetY}" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
