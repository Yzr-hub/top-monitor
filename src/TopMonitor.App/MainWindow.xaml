<Window x:Class="TopMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:TopMonitor.App.Converters"
        Title="TopMonitor"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Topmost="{Binding AlwaysOnTop}"
        WindowStyle="None"
        MouseLeftButtonDown="OnMouseLeftButtonDown">
    <Border Padding="14,8"
            Background="{Binding Opacity,
                                 Converter={x:Static converters:OpacityToBackgroundConverter.Instance}}"
            CornerRadius="{Binding CornerRadius}">
        <ItemsControl ItemsSource="{Binding Metrics}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="{Binding DataContext.HorizontalSpacing,
                                           RelativeSource={RelativeSource AncestorType=Window},
                                           Converter={x:Static converters:HorizontalSpacingConverter.Instance}}"
                          VerticalAlignment="Center"
                          TextElement.FontFamily="Segoe UI"
                          TextElement.FontSize="{Binding DataContext.FontSize,
                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                          TextElement.FontWeight="SemiBold"
                          TextElement.Foreground="{Binding DataContext.TextColor,
                                                          RelativeSource={RelativeSource AncestorType=Window}}">
                        <TextBlock x:Name="ReservationSizer"
                                   IsHitTestVisible="False"
                                   Opacity="0"
                                   Text="{Binding ReservationText}" />
                        <TextBlock Width="{Binding ActualWidth,
                                                   ElementName=ReservationSizer}"
                                   Text="{Binding DisplayText}"
                                   TextAlignment="Right"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
